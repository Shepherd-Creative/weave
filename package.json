{
  "name": "weave",
  "version": "0.0.0",
  "private": true,
  "description": "Weave — JSON-composable React primitives + MCP server for LLM-driven dashboards.",
  "homepage": "https://github.com/Shepherd-Creative/weave",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shepherd-Creative/weave.git"
  },
  "author": "Shepherd Creative",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^22.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
