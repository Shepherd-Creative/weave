{
  "name": "@shepherd-creative/weave-tokens",
  "version": "0.2.0",
  "description": "Default CSS variables for Weave primitives (opt-in).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shepherd-Creative/weave.git",
    "directory": "packages/weave-tokens"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "style": "./tokens.css",
  "exports": {
    ".": "./tokens.css",
    "./tokens.css": "./tokens.css",
    "./tokens.json": "./tokens.json",
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "default": "./dist/validate.js"
    }
  },
  "files": [
    "tokens.css",
    "tokens.json",
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
