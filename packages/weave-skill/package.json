{
  "name": "@shepherd-creative/weave-skill",
  "version": "0.0.0",
  "description": "SKILL.md teaching LLMs to compose Weave primitives, plus a loader utility.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shepherd-Creative/weave.git",
    "directory": "packages/weave-skill"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
