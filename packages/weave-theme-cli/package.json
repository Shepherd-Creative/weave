{
  "name": "@shepherd-creative/weave-theme-cli",
  "version": "0.1.0",
  "description": "Deterministic authoring-time lint gate for Weave theme directories.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shepherd-Creative/weave.git",
    "directory": "packages/weave-theme-cli"
  },
  "type": "module",
  "exports": {
    "./lint": {
      "types": "./dist/lint.d.ts",
      "import": "./dist/lint.js"
    }
  },
  "bin": {
    "weave-theme": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@shepherd-creative/weave-tokens": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
